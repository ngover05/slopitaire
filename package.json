{
  "name": "slopitaire",
  "version": "1.0.0",
  "private": true,
  "description": "Slopitaire // PRISM — Futuristic anime Klondike solitaire desktop & web app",
  "author": "Slopitaire",
  "homepage": "https://github.com/ngover05/slopitaire",
  "desktopName": "slopitaire.desktop",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js --static",
    "test:auth": "node server/test-auth.js",
    "test:smoke": "electron . --smoke-test",
    "music": "electron tools/music/main.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable nsis",
    "dist:win": "electron-builder --win portable nsis",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.slopitaire.prism",
    "productName": "Slopitaire",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "images/**/*",
      "audio/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "audio/**/*"
    ],
    "compression": "normal",
    "win": {
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "icon": "electron/icon.png",
      "category": "Game",
      "synopsis": "Futuristic anime Klondike solitaire",
      "executableName": "slopitaire",
      "maintainer": "Slopitaire",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Slopitaire",
          "GenericName": "Solitaire",
          "Keywords": "solitaire;klondike;cards;game;",
          "StartupWMClass": "slopitaire"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "packageCategory": "games",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
