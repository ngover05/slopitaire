# Slopitaire // PRISM — Environment Configuration
# Copy to .env and fill in your Google OAuth2 credentials to enable Google accounts & cloud sync.
# Guest play works without configuring these values.

# Web server / Docker Compose public port (Nginx frontend)
PORT=8080

# Node.js API server port & bind address
API_PORT=3000
API_HOST=0.0.0.0

# Public origin used when generating OAuth redirect URIs (leave empty to derive from Host / X-Forwarded-Proto)
PUBLIC_BASE_URL=http://localhost:8080

# Google OAuth2 Web Application credentials (from Google Cloud Console -> Credentials)
# Authorized redirect URIs to register in Google Cloud Console:
#   - http://localhost:8080/api/auth/google/callback   (Docker / Nginx)
#   - http://localhost:3000/api/auth/google/callback   (Standalone Node dev server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional explicit OAuth callback override (defaults to <PUBLIC_BASE_URL or request origin>/api/auth/google/callback)
GOOGLE_REDIRECT_URI=

# Optional secret / CORS allowlist (comma-separated origins)
SESSION_SECRET=
ALLOWED_ORIGINS=

# SQLite database path (Docker overrides this to /data/slopitaire.db)
# SQLITE_PATH=./server/data/slopitaire.db
